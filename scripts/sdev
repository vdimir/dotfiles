#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.10"
# dependencies = ["questionary"]
# ///

"""
Script for ssh-ing into particular folder on remote dev server interactively.
"""

import sys
import os
import re
import json
import subprocess
import argparse
import time
import uuid
from fnmatch import fnmatch

import questionary

class Stopwatch:
    def __init__(self):
        self.start = time.time()

    def elapsed(self):
        return time.time() - self.start

def agterm_adopt(hostname, session_name):
    """Wire agterm-remote status for this session (like `agr open`): ensure the
    socket bridge, relabel the sidebar row, and return a remote shell snippet
    that records agterm-session-id -> tmux-session-name for the agr status hook.
    No-op outside agterm or when agr is not installed."""
    sid = os.environ.get('AGTERM_SESSION_ID')
    agr = os.path.expanduser('~/.local/bin/agr')
    if not sid or not os.access(agr, os.X_OK):
        return ''
    subprocess.run([agr, 'up', hostname])
    subprocess.run(['agtermctl', 'session', 'rename', session_name, '--target', sid],
                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    return f'mkdir -p ~/.cache/agterm/targets; printf %s {sid} > ~/.cache/agterm/targets/{session_name}; '

def kitty_window_titles():
    """Titles of all kitty windows except the one running this script, used to
    spot tmux sessions that already have a local kitty tab. Empty set outside
    kitty or when remote control is unavailable."""
    if not os.environ.get('KITTY_LISTEN_ON'):
        return set()
    try:
        result = subprocess.run(['kitten', '@', 'ls'], stdout=subprocess.PIPE,
                                stderr=subprocess.DEVNULL, timeout=2)
        if result.returncode != 0:
            return set()
        win_id = os.environ.get('KITTY_WINDOW_ID')
        titles = set()
        for os_window in json.loads(result.stdout):
            for tab in os_window.get('tabs', []):
                for window in tab.get('windows', []):
                    if win_id and str(window.get('id')) == win_id:
                        continue
                    titles.add(window.get('title', ''))
        return titles
    except (subprocess.TimeoutExpired, ValueError, OSError):
        return set()

def focus_kitty_tab(session_name):
    """If some kitty window already holds this tmux session (its tab title was
    set to the session name on attach), focus it instead of attaching again.
    Needs `allow_remote_control socket-only` + `listen_on` in kitty.conf.
    Returns True if a window was focused."""
    if not os.environ.get('KITTY_LISTEN_ON'):
        return False
    # tmux set-titles-string is "<pane title> (<session>)", or bare session name
    match = f'title:^(?:{re.escape(session_name)}|.* \\({re.escape(session_name)}\\))$'
    win_id = os.environ.get('KITTY_WINDOW_ID')
    if win_id:
        match += f' and not id:{win_id}'
    result = subprocess.run(
        ['kitten', '@', 'focus-window', '--match', match],
        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    return result.returncode == 0

def set_tab_title(title):
    """Set terminal tab/window title via OSC escape (kitty, iTerm2, etc.)."""
    print(f'\033]0;{title}\007', end='', flush=True)

if __name__ == '__main__':
    argparser = argparse.ArgumentParser()
    argparser.add_argument('-b', help='git branch pattern')
    argparser.add_argument('-i', action='store_true', help='Continue interactive mode after running command')
    argparser.add_argument('cmd', nargs='*', default=None, help='Command to run')
    argparser.add_argument('--host', default=os.getenv('SSH_DEV_HOST', ''), help='SSH host to connect to')
    args = argparser.parse_args()

    hostname = args.host
    if not hostname:
        argparser.error('no host: pass --host or set SSH_DEV_HOST')
    get_folders_cmd = f"""
        ssh {hostname} 'bash -c "for f in ClickHouse* clickhouse-*; do
            [ -d \\"\\$f\\" ] && [ -d \\"\\$f/.git\\" ] || continue;
            echo -n \\"\\$f \\";
            git -C \\"\\$f\\" rev-parse --abbrev-ref HEAD;
        done"'
    """.strip()

    tmux_fmt = "session_name=#{session_name}\tcmd=#{pane_current_command}\tattached=#{session_attached}\ttitle=#{pane_title}\thost=#{host}"
    get_sessions_cmd = f"ssh {hostname} 'tmux list-sessions -F \"{tmux_fmt}\" 2>/dev/null'"

    folders_proc = subprocess.Popen(get_folders_cmd, shell=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
    sessions_proc = subprocess.Popen(get_sessions_cmd, shell=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE)

    sw = Stopwatch()
    while folders_proc.poll() is None:
        time.sleep(0.1)
        print(f'\r{sw.elapsed():.02f}s', end='', flush=True)
    print()

    folders_stdout, folders_stderr = folders_proc.communicate()
    sessions_stdout, _ = sessions_proc.communicate()

    if folders_proc.returncode != 0:
        print(folders_stdout.decode('utf-8'), end='')
        print(folders_stderr.decode('utf-8'), end='', file=sys.stderr)
        sys.exit(1)

    folders_with_branches = list(filter(lambda x: len(x) == 2, (name.strip().split(' ') for name in folders_stdout.decode('utf-8').splitlines())))
    def parse_tmux_session(line):
        fields = dict(f.split('=', 1) for f in line.strip().split('\t') if '=' in f)
        return fields

    tmux_sessions = [s for s in (parse_tmux_session(line) for line in sessions_stdout.decode('utf-8').splitlines() if line.strip()) if s.get('session_name')]

    if args.b:
        folders_with_branches = list(filter(lambda x: fnmatch(x[1], f"*{args.b}*"), folders_with_branches))

    if not folders_with_branches and not tmux_sessions:
        print('No ClickHouse folders or tmux sessions found')
        sys.exit(1)

    selection = None
    if args.b and len(folders_with_branches) == 1 and not tmux_sessions:
        selection = ('folder', 0)

    if selection is None:
        kitty_titles = kitty_window_titles() if tmux_sessions else set()
        choices = []
        for session in tmux_sessions:
            name = session.get('session_name', '?')
            cmd = session.get('cmd', '')
            attached = session.get('attached', '0') != '0'
            in_kitty = any(t == name or t.endswith(f' ({name})') for t in kitty_titles)
            tag = '◉' if in_kitty else ('●' if attached else '○')
            label = f"{tag} {name}  ({cmd})" if cmd else f"{tag} {name}"
            # pane_title carries app status (e.g. Claude Code sets it via OSC);
            # it defaults to the host name, so only show it when overridden
            title = session.get('title', '')
            if title and title not in (session.get('host', ''), cmd, name):
                label += f"  — {title}"
            choices.append(questionary.Choice(label, ('session', name)))
        for i, (name, branch) in enumerate(folders_with_branches):
            choices.append(questionary.Choice(f"{name} @ {branch}", ('folder', i)))

        question = questionary.select(
            f"SSH into @{hostname}:",
            choices=choices,
            pointer='▸',
            use_shortcuts=True,
            style=questionary.Style([
                ("highlighted", "fg:#ffffff"),
                ("text", "fg:#aaaaaa"),
            ])
        )

        @question.application.key_bindings.add('escape')
        @question.application.key_bindings.add('q')
        def _cancel(event):
            event.app.exit(result=None)

        result = question.ask()
        if result is None:
            sys.exit(1)
        selection = result

    kind, value = selection

    if kind == 'session':
        if focus_kitty_tab(value):
            print(f"Switched to kitty tab already attached to '{value}'")
            sys.exit(0)
        print(f"Attaching to tmux session '{value}'...")
        set_tab_title(value)
        adopt = agterm_adopt(hostname, value)
        subprocess.run(f"ssh -t {hostname} '{adopt}tmux attach -t {value}'", shell=True)
    else:
        folder, branch = folders_with_branches[value]
        folder_safe = re.sub(r'[^a-z0-9]', '-', folder.lower())
        session_name = f"{folder_safe[:48]}-{uuid.uuid4().hex[:6]}"
        set_tab_title(session_name)
        adopt = agterm_adopt(hostname, session_name)

        if args.cmd:
            command = ' '.join(args.cmd)
            print(f"SSHing into {folder} @ '{branch}' via tmux '{session_name}' running '{command}'...")
            if args.i:
                subprocess.run(f"ssh -t {hostname} '{adopt}tmux new-session -A -s {session_name} -c \"$HOME/{folder}\" fish -C \"{command}\"'", shell=True)
            else:
                subprocess.run(f"ssh -t {hostname} '{adopt}tmux new-session -A -s {session_name} -c \"$HOME/{folder}\" bash -c \"{command}\"'", shell=True)
        else:
            print(f"SSHing into {folder} @ '{branch}' via tmux '{session_name}'...")
            subprocess.run(f"ssh -t {hostname} '{adopt}tmux new-session -A -s {session_name} -c \"$HOME/{folder}\" fish'", shell=True)
