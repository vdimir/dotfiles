#!/usr/bin/env python3

"""
Detect ports listened on the remote dev server and forward them in the background:
enter forwards the selected port, `o` forwards and opens http://localhost:PORT,
space toggles forwards without leaving the menu, `x` blacklists a port.
Already-forwarded ports are marked with ⇄. `sfwd -k` stops all forwards.
"""

import sys
import os
import re
import subprocess
import shlex
import argparse
import threading
import time

import questionary

PORT_RANGE = (3000, 9999)
SKIP_PROCS = re.compile(r'^(\?|code-|MainThread)')

# ports hidden from the menu; press `x` on a port to add it here, edit to undo
BLACKLIST = ['9004', '9005', '9009', '9010', '9181', '9223', '9234']

def blacklist_port(port):
    """Persist a blacklisted port by rewriting the BLACKLIST line of this file."""
    BLACKLIST.append(port)
    path = os.path.abspath(__file__)
    with open(path) as f:
        src = f.read()
    src = re.sub(r'^BLACKLIST = \[.*\]$', f'BLACKLIST = {BLACKLIST!r}',
                 src, count=1, flags=re.MULTILINE)
    with open(path, 'w') as f:
        f.write(src)

REMOTE_CMD = '''
ss -tlnp 2>/dev/null
echo "__INFO__"
for pid in $(ss -tlnp 2>/dev/null | grep -o "pid=[0-9]*" | cut -d= -f2 | sort -u); do
  printf "%s\\t%s\\t%s\\n" "$pid" "$(readlink /proc/$pid/cwd 2>/dev/null)" \
    "$(tr "\\0" " " < /proc/$pid/cmdline 2>/dev/null | cut -c1-160)"
done
'''

def describe(pid, pid_info):
    """Short human description of a process: command line with the binary
    shortened to its basename, plus the cwd relative to home."""
    cwd, args = pid_info.get(pid, ('', ''))
    parts = args.split()
    if parts:
        parts[0] = os.path.basename(parts[0])
    desc = ' '.join(parts)[:60]
    cwd = re.sub(r'^/home/[^/]+/?', '', cwd)
    if cwd:
        desc += f'  [{cwd}]'
    return desc

def remote_listeners(hostname):
    """{port: description} for TCP listeners on the remote host, filtered to
    interesting ports and named processes."""
    # remote login shell is fish, so run the snippet via bash explicitly
    result = subprocess.run(['ssh', hostname, 'bash -c ' + shlex.quote(REMOTE_CMD)],
                            stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
    ss_out, _, info_out = result.stdout.decode('utf-8').partition('__INFO__')

    pid_info = {}
    for line in info_out.splitlines():
        fields = line.split('\t')
        if len(fields) == 3:
            pid_info[fields[0]] = (fields[1], fields[2].strip())

    ports = {}
    for line in ss_out.splitlines()[1:]:
        cols = line.split()
        m = re.search(r':(\d+)$', cols[3]) if len(cols) >= 4 else None
        if not m or not PORT_RANGE[0] <= int(m.group(1)) <= PORT_RANGE[1]:
            continue
        if m.group(1) in BLACKLIST:
            continue
        proc = re.search(r'\(\("([^"]+)",pid=(\d+)', line)
        if not proc or SKIP_PROCS.match(proc.group(1)):
            continue
        ports.setdefault(m.group(1), describe(proc.group(2), pid_info) or proc.group(1))
    return ports

def active_forwards(hostname):
    """{port: pid} of background forwards started by this script."""
    ps = subprocess.run(['ps', 'ax', '-o', 'pid=,command='], stdout=subprocess.PIPE)
    pattern = r'^\s*(\d+)\s+ssh -f -N -o ExitOnForwardFailure[= ]yes -L (\d+):\S+ ' + re.escape(hostname) + r'$'
    return {m.group(2): int(m.group(1))
            for m in re.finditer(pattern, ps.stdout.decode('utf-8'), re.MULTILINE)}

def start_forward(hostname, port):
    return subprocess.run(
        ['ssh', '-f', '-N', '-o', 'ExitOnForwardFailure=yes',
         '-L', f'{port}:localhost:{port}', hostname],
        stdin=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode == 0

def wait_key():
    """Wait for a single keypress so a launcher-spawned terminal window
    doesn't close before the message can be read."""
    print('press any key to close...', end='', file=sys.stderr, flush=True)
    try:
        import termios, tty
        fd = sys.stdin.fileno()
        old = termios.tcgetattr(fd)
        try:
            tty.setraw(fd)
            sys.stdin.read(1)
        finally:
            termios.tcsetattr(fd, termios.TCSADRAIN, old)
    except Exception:
        try:
            input()
        except EOFError:
            pass
    print(file=sys.stderr)

def fail(msg):
    print(msg, file=sys.stderr)
    wait_key()
    sys.exit(1)

def _excepthook(tp, val, tb):
    sys.__excepthook__(tp, val, tb)
    if tp is not KeyboardInterrupt:
        wait_key()

sys.excepthook = _excepthook

def open_if_http(port):
    url = f'http://localhost:{port}'
    if subprocess.run(['curl', '-s', '-o', '/dev/null', '-m', '2', url]).returncode == 0:
        subprocess.run(['open', url])
        return True
    return False

if __name__ == '__main__':
    argparser = argparse.ArgumentParser(description=__doc__)
    argparser.add_argument('-k', action='store_true', help='stop all forwards')
    argparser.add_argument('--host', default=os.getenv('SSH_DEV_HOST', ''), help='SSH host to connect to')
    args = argparser.parse_args()
    hostname = args.host

    active = active_forwards(hostname)

    if args.k:
        if not active:
            print('No active forwards')
        for port, pid in active.items():
            os.kill(pid, 15)
            print(f'stopped :{port} (pid {pid})')
        sys.exit(0)

    listeners = remote_listeners(hostname)
    if not listeners:
        fail(f'No listening ports found on {hostname}')

    def label(port, tag=None):
        if tag is None:
            tag = '⇄' if port in active else ' '
        return f'{tag} {port:<6} {listeners[port]}'

    choices = [questionary.Choice(label(port), port)
               for port in sorted(listeners, key=int)]

    question = questionary.select(
        f"Forward port from @{hostname}:",
        choices=choices,
        pointer='▸',
        use_shortcuts=True,
        instruction='(space: start/stop, enter: forward, f: forward + open, x: blacklist)',
        style=questionary.Style([
            ("highlighted", "fg:#ffffff"),
            ("text", "fg:#aaaaaa"),
        ])
    )

    # space toggles the forward for the highlighted port without leaving the menu
    from questionary.prompts.common import InquirerControl
    ic = next(w.content for w in question.application.layout.find_all_windows()
              if isinstance(w.content, InquirerControl))

    pending = set()

    @question.application.key_bindings.add(' ')
    def _toggle(event):
        choice = ic.get_pointed_at()
        port = choice.value
        if port in pending:
            return
        if port in active:
            os.kill(active.pop(port), 15)
            choice.title = label(port)
            return
        # show pending marker right away, establish the forward in background
        pending.add(port)
        choice.title = label(port, '◌')
        app = event.app

        def establish():
            ok = start_forward(hostname, port)
            if ok:
                active.update(active_forwards(hostname))
            pending.discard(port)
            choice.title = label(port) if ok else label(port, '✗')
            app.invalidate()

        threading.Thread(target=establish, daemon=True).start()

    @question.application.key_bindings.add('escape')
    @question.application.key_bindings.add('q')
    def _cancel(event):
        event.app.exit(result=None)

    want_open = []

    @question.application.key_bindings.add('f')
    def _open(event):
        want_open.append(True)
        event.app.exit(result=ic.get_pointed_at().value)

    @question.application.key_bindings.add('x')
    def _blacklist(event):
        choice = ic.get_pointed_at()
        blacklist_port(choice.value)
        ic.choices.remove(choice)
        if not ic.choices:
            event.app.exit(result=None)
            return
        ic.pointed_at = min(ic.pointed_at, len(ic.choices) - 1)

    port = question.ask()
    if port is None:
        sys.exit(0)
    while port in pending:  # enter pressed while its forward is being set up
        time.sleep(0.05)

    if port not in active:
        if not start_forward(hostname, port):
            fail(f'failed to forward :{port}')
        print(f'⇄ forwarding localhost:{port} -> {hostname}:{port}')

    if want_open and not open_if_http(port):
        print(f'localhost:{port} does not speak HTTP, forward kept in background')
